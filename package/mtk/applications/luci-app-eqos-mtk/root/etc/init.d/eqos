#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=50
USE_PROCD=1

log_debug() {
	logger -p daemon.debug -t eqos-init "$*" 2>/dev/null || true
}

cleanup_loadbalance_rules() {
	local interfaces="$1"
	local count i var ipaddr

	[ -n "$interfaces" ] || {
		log_debug "[EQOS-B014-01] skip loadbalance cleanup: empty interface list"
		return 0
	}

	count=$(echo "$interfaces" | tr ',' ' ' | wc -w | tr -d ' ')
	[ "${count:-0}" -gt 0 ] || {
		log_debug "[EQOS-B014-02] skip loadbalance cleanup: interface_count=$count"
		return 0
	}

	log_debug "[EQOS-B014-03] cleanup loadbalance rules: interfaces=$interfaces count=$count"
	i=0
	for var in $(echo "$interfaces" | tr ',' ' '); do
		ipaddr=$(ip route show | grep default | grep "$var" | awk '{print $3}' | head -1)
		while iptables -t mangle -D PREROUTING -i br-lan \
			-m conntrack --ctstate NEW \
			-m statistic --mode nth --every "$count" --packet "$i" \
			-j CONNMARK --set-mark 2"$i" 2>/dev/null; do :; done
		while iptables -t mangle -D PREROUTING -i br-lan \
			-m connmark --mark 2"$i" -j MARK --set-mark 2"$i" 2>/dev/null; do :; done
		if [ -n "$ipaddr" ]; then
			while iptables -t mangle -D PREROUTING \
				-m conntrack --ctstate NEW -d "$ipaddr/24" \
				-j MARK --set-mark 2"$i" 2>/dev/null; do :; done
		fi
		ip route del default table 2"$i"0 2>/dev/null
		ip rule del fwmark 2"$i" table 2"$i"0 2>/dev/null
		i=$((i + 1))
	done

	while iptables -t mangle -D PREROUTING -p tcp --dport 443 \
		-m conntrack --ctstate NEW -j MARK --set-mark 20 2>/dev/null; do :; done
	while iptables -t mangle -D PREROUTING -p udp --dport 443 \
		-m conntrack --ctstate NEW -j MARK --set-mark 20 2>/dev/null; do :; done
	while iptables -t mangle -D POSTROUTING \
		-m conntrack --ctstate NEW -j CONNMARK --save-mark 2>/dev/null; do :; done
	while iptables -t mangle -D PREROUTING -i br-lan \
		-m conntrack --ctstate ESTABLISHED,RELATED \
		-j CONNMARK --restore-mark 2>/dev/null; do :; done
	ip route flush cache
	log_debug "[EQOS-B014-04] cleanup loadbalance rules done: interfaces=$interfaces"
}

parse_device() {
	local cfg="$1"

	local enabled
	config_get_bool enabled "$cfg" "enabled" "1"
	[ "$enabled" -eq "1" ] || return 1
	

	local ip download upload comment mac interfacename
	config_get ip "$cfg" ip
	config_get download "$cfg" "download"
	config_get upload "$cfg" "upload"
	config_get comment "$cfg" "comment"
	config_get mac "$cfg" "mac"
	config_get interfacename "$cfg" "interfacename"
	eqos add "$ip" "$download" "$upload" "$comment" "$mac" "$interfacename"
}

start_service() {
	config_load "eqos"

	local enabled
	config_get_bool enabled "config" "enabled" "0"
	[ "$enabled" -eq "1" ] || return 1
	
	local download upload comment
	config_get download "config" "download"
	config_get upload "config" "upload"
	config_get comment "config" "comment"
	config_get smarthqos "config" "smarthqos"
	config_get interface "config" "interface"
	eqos start "$download" "$upload" "$comment" 
	
	local ipv6enabled                              
        config_get_bool ipv6enabled "config" "ipv6enabled" "0"    
        ip6tables -t mangle -N eqos
        ip6tables -t mangle -F eqos
        ebtables -t nat  -N eqos
        ebtables -t nat  -F eqos
        if [ "$ipv6enabled" -eq "1" ]; then                                
        ebtables -t nat -D POSTROUTING  -j eqos -p ipv6              
        ebtables -t nat -A POSTROUTING  -j eqos -p ipv6
        ip6tables -t mangle -D FORWARD  -j eqos
        ip6tables -t mangle -A FORWARD  -j eqos             
        fi  

        if [ "$smarthqos" -eq "1" ]; then
        # Q2-Q30: per-user upload WRR (sch2). Always bind to sch2 regardless of rate.
        # BUG FIX: when upload=0, previously skipped → queues stayed on sch0 (SP)!
        for i in $(seq 2 30); do
            if [ "${upload:-0}" -ne "0" ]; then
                echo 2 1 $(($upload*225)) 1 $(($upload*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq$i
            else
                echo 2 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
            fi
        done
        # Q34-Q62: per-user download WRR (sch3). Same guard as above.
        for i in $(seq 34 62); do
            if [ "${download:-0}" -ne "0" ]; then
                echo 3 1 $(($download*200)) 1 $(($download*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq$i
            else
                echo 3 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
            fi
        done
        fi

	        if [ -n "$interface" ]; then
		cleanup_loadbalance_rules "$interface"
		bash /usr/sbin/loadbalance "$interface"
	        fi
        config_foreach parse_device "device"
        if [ "$smarthqos" -eq "1" ]; then
        rm /etc/hotplug.d/dhcp/99-eqos
	cat << 'EOF' > /etc/hotplug.d/dhcp/99-eqos
#!/bin/sh

# 只有在新增 DHCP 租约时才执行操作
if [ "$ACTION" = "add" ]; then

    # 执行指定的命令
    /etc/init.d/dhcp_mark.sh eqos init
fi
EOF

        chmod +x /etc/hotplug.d/dhcp/99-eqos
        /etc/init.d/dnsmasq restart
        /etc/init.d/dhcp_mark.sh eqos init
        fi   
}

stop_service() {
	config_load "eqos"
	local interface
	config_get interface "config" "interface"
	cleanup_loadbalance_rules "$interface"
	eqos stop
	rm -f /etc/hotplug.d/dhcp/99-eqos
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "eqos"
}
