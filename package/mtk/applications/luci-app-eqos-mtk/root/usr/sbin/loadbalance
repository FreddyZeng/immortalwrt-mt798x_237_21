interface=$1
array=(${interface//,/ })
        PPP_NUM=0

        for var in ${array[@]}
        do
        let PPP_NUM=PPP_NUM+1
        done
        
        i=0
        for var in ${array[@]}
        do
        ipaddr=$(ip route show |grep default | grep $var | awk '{print $3 }')
        local FW_MARK=$(printf "0x%02x00" "2${i}")
        iptables -t mangle -D PREROUTING -i br-lan -m conntrack --ctstate NEW -m statistic --mode nth --every $PPP_NUM --packet $i -j CONNMARK --set-xmark ${FW_MARK}/0xFF00 2>/dev/null
        iptables -t mangle -D PREROUTING -i br-lan -m connmark --mark ${FW_MARK}/0xFF00 -j MARK --set-xmark ${FW_MARK}/0xFF00 2>/dev/null
        iptables -t mangle -A PREROUTING -i br-lan -m conntrack --ctstate NEW -m statistic --mode nth --every $PPP_NUM --packet $i -j CONNMARK --set-xmark ${FW_MARK}/0xFF00
        iptables -t mangle -A PREROUTING -i br-lan -m connmark --mark ${FW_MARK}/0xFF00 -j MARK --set-xmark ${FW_MARK}/0xFF00
        ip rule del table 2"${i}"0 2>/dev/null
        ip rule add fwmark ${FW_MARK}/0xff00 table 2"${i}"0
        ip route del default table 2"${i}"0 2>/dev/null
        ip route add default via $ipaddr dev $var table 2"${i}"0
        let i=i+1
        done
        
        
        i=0
        for var in ${array[@]}
        do
        ipaddr=$(ip route show |grep default | grep $var | awk '{print $3 }')
        local FW_MARK=$(printf "0x%02x00" "2${i}")
        iptables -t mangle -D PREROUTING  -m conntrack --ctstate NEW -d $ipaddr/24 -j MARK --set-xmark ${FW_MARK}/0xFF00 2>/dev/null
        iptables -t mangle -A PREROUTING  -m conntrack --ctstate NEW -d $ipaddr/24 -j MARK --set-xmark ${FW_MARK}/0xFF00
        let i=i+1
        done
        
        iptables -t mangle -D PREROUTING -p tcp --dport 443 -m conntrack --ctstate NEW -j MARK --set-xmark 0x2000/0xFF00 2>/dev/null
        iptables -t mangle -A PREROUTING -p tcp --dport 443 -m conntrack --ctstate NEW -j MARK --set-xmark 0x2000/0xFF00
        
        iptables -t mangle -D PREROUTING -p udp --dport 443 -m conntrack --ctstate NEW -j MARK --set-xmark 0x2000/0xFF00 2>/dev/null
        iptables -t mangle -A PREROUTING -p udp --dport 443 -m conntrack --ctstate NEW -j MARK --set-xmark 0x2000/0xFF00
        
        iptables -t mangle -D POSTROUTING -m conntrack --ctstate NEW -j CONNMARK --save-mark --nfmask 0xFF00 --ctmask 0xFF00 2>/dev/null
        iptables -t mangle -A POSTROUTING -m conntrack --ctstate NEW -j CONNMARK --save-mark --nfmask 0xFF00 --ctmask 0xFF00
        iptables -t mangle -D PREROUTING -i br-lan -m conntrack --ctstate ESTABLISHED,RELATED -j CONNMARK --restore-mark --nfmask 0xFF00 --ctmask 0xFF00 2>/dev/null
        iptables -t mangle -A PREROUTING -i br-lan -m conntrack --ctstate ESTABLISHED,RELATED -j CONNMARK --restore-mark --nfmask 0xFF00 --ctmask 0xFF00
        ip route flush cache
