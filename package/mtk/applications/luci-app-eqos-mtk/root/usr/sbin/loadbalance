interface=$1
array=(${interface//,/ })
        PPP_NUM=0
        TPROXY_MARK_GUARD="-m mark ! --mark 0x8000/0x8000"

        log_debug() {
        logger -p daemon.debug -t eqos-loadbalance "$*" 2>/dev/null || true
        }

        log_debug "[EQOS-B014-11] rebuild loadbalance rules: interface=$interface"

        for var in ${array[@]}
        do
        let PPP_NUM=PPP_NUM+1
        done
        
        i=0
        for var in ${array[@]}
        do
        ipaddr=$(ip route show |grep default | grep $var | awk '{print $3 }')
        iptables -t mangle -D PREROUTING -i br-lan $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -m statistic --mode nth --every $PPP_NUM --packet $i -j CONNMARK --set-mark 2"$i"
        iptables -t mangle -D PREROUTING -i br-lan $TPROXY_MARK_GUARD -m connmark --mark 2"$i" -j MARK --set-mark 2"$i"
        iptables -t mangle -A PREROUTING -i br-lan $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -m statistic --mode nth --every $PPP_NUM --packet $i -j CONNMARK --set-mark 2"$i"
        iptables -t mangle -A PREROUTING -i br-lan $TPROXY_MARK_GUARD -m connmark --mark 2"$i" -j MARK --set-mark 2"$i"
        ip rule del fwmark 2"$i" table 2"$i"0 2>/dev/null
        ip rule add fwmark 2"$i" table 2"$i"0
        ip route del default table 2"$i"0 2>/dev/null
        ip route add default via $ipaddr dev $var table 2"$i"0
        let i=i+1
        done
        
        
        i=0
        for var in ${array[@]}
        do
        ipaddr=$(ip route show |grep default | grep $var | awk '{print $3 }')
        iptables -t mangle -D PREROUTING $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -d $ipaddr/24 -j MARK --set-mark 2"$i"
        iptables -t mangle -A PREROUTING $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -d $ipaddr/24 -j MARK --set-mark 2"$i"
        let i=i+1
        done
        
        iptables -t mangle -D PREROUTING -p tcp --dport 443 $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -j MARK --set-mark 20
        iptables -t mangle -A PREROUTING -p tcp --dport 443 $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -j MARK --set-mark 20
        
        iptables -t mangle -D PREROUTING -p udp --dport 443 $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -j MARK --set-mark 20
        iptables -t mangle -A PREROUTING -p udp --dport 443 $TPROXY_MARK_GUARD -m conntrack --ctstate NEW -j MARK --set-mark 20
        
        iptables -t mangle -D POSTROUTING -m conntrack --ctstate NEW -j CONNMARK --save-mark
        iptables -t mangle -A POSTROUTING -m conntrack --ctstate NEW -j CONNMARK --save-mark
        iptables -t mangle -D PREROUTING -i br-lan $TPROXY_MARK_GUARD -m conntrack --ctstate ESTABLISHED,RELATED -j CONNMARK --restore-mark
        iptables -t mangle -A PREROUTING -i br-lan $TPROXY_MARK_GUARD -m conntrack --ctstate ESTABLISHED,RELATED -j CONNMARK --restore-mark
        ip route flush cache
        log_debug "[EQOS-B014-12] rebuild loadbalance rules done: interface=$interface ppp_num=$PPP_NUM"
