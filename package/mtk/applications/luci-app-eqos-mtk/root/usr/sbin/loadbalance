#!/bin/sh
# loadbalance - 多 WAN 负载均衡 (POSIX sh)
# cfg_idx=原始配置位置(决定mark/table) | nth_idx=可用顺序(决定nth分流)

interface=$1
iface_list=$(echo "$interface" | tr ',' ' ')

# ── 1. 精确迁移清理：只删旧版 loadbalance 特有规则形态 ───────────────────
# 不泛删所有 0xFF00（避免误删 mwan3 等），只匹配三种旧版特征：
#   A: -m statistic --mode nth + -j CONNMARK  (nth 负载均衡，仅 loadbalance 用)
#   B: -i br-lan + -m connmark + -j MARK      (connmark restore，仅 loadbalance 用)
#   C: --dport 443 + -j MARK                  (HTTPS 固定出口，仅 loadbalance 用)
#   D: --ctstate NEW + /24 + -j MARK          (回程路由 MARK，仅 loadbalance 用)
iptables-save -t mangle 2>/dev/null | while IFS= read -r _ln; do
    case "$_ln" in
        # A: nth 负载均衡 CONNMARK (186cfba8+ 版，-m statistic + -j CONNMARK)
        "-A PREROUTING "*"-m statistic ""--mode nth"*"-j CONNMARK "*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # B: connmark restore (186cfba8+ 版，br-lan + connmark + -j MARK)
        "-A PREROUTING "*"-i br-lan"*"-m connmark"*"-j MARK "*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # C: HTTPS 443 MARK (任意版本，loadbalance 是唯一在 PREROUTING 写 443 MARK 的)
        "-A PREROUTING "*"--dport 443"*"-j MARK "*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # D: 回程路由 MARK xmark 形式 (186cfba8+ 版，--set-xmark 0x2xxx/0xFF00)
        "-A PREROUTING "*"/24"*"-j MARK "*"--set-xmark 0x2"*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # E: nth MARK bash 旧版 (直接用 -j MARK --set-mark，不用 CONNMARK)
        "-A PREROUTING "*"-m statistic ""--mode nth"*"-j MARK "*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # F: 回程路由 MARK bash 旧版 (--set-mark 2x，十进制无掩码)
        "-A PREROUTING "*"/24"*"-j MARK "*"--set-mark 2"*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
        # G: POSTROUTING save-mark 旧版 (无 nfmask/ctmask，我们立即以带掩码版本重装)
        "-A POSTROUTING "*"--ctstate NEW"*"-j CONNMARK ""--save-mark"*)
            set -- $_ln; shift 2; iptables -t mangle -D POSTROUTING "$@" 2>/dev/null ;;
        # H: PREROUTING br-lan restore-mark 旧版 (无 nfmask/ctmask，我们立即以带掩码版本重装)
        "-A PREROUTING "*"-i br-lan"*"-j CONNMARK ""--restore-mark"*)
            set -- $_ln; shift 2; iptables -t mangle -D PREROUTING "$@" 2>/dev/null ;;
    esac
done

# ── 2. 创建/清空专属子链 ──────────────────────────────────────────────────
iptables -t mangle -N eqos_lb 2>/dev/null
iptables -t mangle -F eqos_lb
iptables -t mangle -D PREROUTING -j eqos_lb 2>/dev/null

# ── 3. 清理旧 ip rule / ip route（覆盖 WAN 数量减少场景）────────────────
for _ci in 0 1 2 3 4 5 6 7; do
    _om=$(printf "0x%02x00" $((0x20 + _ci)))
    ip rule del fwmark ${_om}/0xff00 2>/dev/null
    ip route flush table "2${_ci}0" 2>/dev/null
done

# ── 4. 构建可用 WAN 列表，cfg_idx 保留原始位置 ───────────────────────────
_tmp=$(mktemp /tmp/eqos_lb_avail.XXXXXX)
cfg_idx=0
PPP_NUM=0
first_cfg_idx=-1
for var in $iface_list; do
    ipaddr=$(ip route show | grep default | grep "$var" | awk '{print $3}')
    if [ -n "$ipaddr" ]; then
        printf '%d %s %s\n' "$cfg_idx" "$var" "$ipaddr" >> "$_tmp"
        PPP_NUM=$((PPP_NUM + 1))
        [ "$first_cfg_idx" -lt 0 ] && first_cfg_idx=$cfg_idx
    else
        logger -p daemon.warn -t loadbalance \
            "[LB-WARN-①] WAN${cfg_idx}($var): no default route, excluded"
    fi
    cfg_idx=$((cfg_idx + 1))
done

if [ "$PPP_NUM" -eq 0 ]; then
    logger -p daemon.err -t loadbalance "[LB-ERR-①] no available WAN, abort"
    rm -f "$_tmp"; exit 1
fi

# HTTPS 固定出口：首个可用 WAN 的 cfg_idx（非硬编码 0x2000）
first_mark=$(printf "0x%02x00" $((0x20 + first_cfg_idx)))

# ── 5. 插入 PREROUTING→eqos_lb 跳转 ─────────────────────────────────────
iptables -t mangle -I PREROUTING 1 -j eqos_lb

# ── 6. 第一轮：nth CONNMARK + ip rule + ip route ─────────────────────────
nth_idx=0
while IFS=' ' read -r cfg_idx var ipaddr; do
    FW_MARK=$(printf "0x%02x00" $((0x20 + cfg_idx)))
    TABLE="2${cfg_idx}0"
    # nth 用 nth_idx (可用顺序)；mark/table 用 cfg_idx (原始位置)
    iptables -t mangle -A eqos_lb \
        -i br-lan -m conntrack --ctstate NEW \
        -m statistic --mode nth --every $PPP_NUM --packet $nth_idx \
        -j CONNMARK --set-xmark ${FW_MARK}/0xFF00
    iptables -t mangle -A eqos_lb \
        -i br-lan -m connmark --mark ${FW_MARK}/0xFF00 \
        -j MARK --set-xmark ${FW_MARK}/0xFF00
    ip rule add fwmark ${FW_MARK}/0xff00 table "$TABLE"
    ip route add default via "$ipaddr" dev "$var" table "$TABLE"
    logger -p daemon.debug -t loadbalance \
        "[LB-②] cfg=$cfg_idx nth=$nth_idx dev=$var mark=$FW_MARK table=$TABLE"
    nth_idx=$((nth_idx + 1))
done < "$_tmp"

# ── 7. 第二轮：回程路由标记 ──────────────────────────────────────────────
while IFS=' ' read -r cfg_idx var ipaddr; do
    FW_MARK=$(printf "0x%02x00" $((0x20 + cfg_idx)))
    iptables -t mangle -A eqos_lb \
        -m conntrack --ctstate NEW \
        -d "$ipaddr/24" -j MARK --set-xmark ${FW_MARK}/0xFF00
done < "$_tmp"

rm -f "$_tmp"

# ── 8. HTTPS 443 固定走首个可用 WAN ──────────────────────────────────────
iptables -t mangle -A eqos_lb \
    -p tcp --dport 443 -m conntrack --ctstate NEW \
    -j MARK --set-xmark ${first_mark}/0xFF00
iptables -t mangle -A eqos_lb \
    -p udp --dport 443 -m conntrack --ctstate NEW \
    -j MARK --set-xmark ${first_mark}/0xFF00

# ── 9. 全局 CONNMARK save/restore（路由域 bits[15:8]）────────────────────
iptables -t mangle -D POSTROUTING -m conntrack --ctstate NEW \
    -j CONNMARK --save-mark --nfmask 0xFF00 --ctmask 0xFF00 2>/dev/null
iptables -t mangle -A POSTROUTING -m conntrack --ctstate NEW \
    -j CONNMARK --save-mark --nfmask 0xFF00 --ctmask 0xFF00
iptables -t mangle -D PREROUTING -i br-lan \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j CONNMARK --restore-mark --nfmask 0xFF00 --ctmask 0xFF00 2>/dev/null
iptables -t mangle -A PREROUTING -i br-lan \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j CONNMARK --restore-mark --nfmask 0xFF00 --ctmask 0xFF00

ip route flush cache
