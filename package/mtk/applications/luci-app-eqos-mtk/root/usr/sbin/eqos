#!/bin/sh

dev=br-lan

stop_qos() {
    tc qdisc del dev $dev root 2>/dev/null
    tc qdisc del dev $dev ingress 2>/dev/null
    tc qdisc del dev ${dev}-ifb root 2>/dev/null
    ip link del dev ${dev}-ifb 2>/dev/null
}

start_qos() {
    local dl=$1
    local up=$2

    tc qdisc add dev $dev root handle 1: htb
    tc class add dev $dev parent 1: classid 1:1 htb rate ${dl}mbit

    ip link add dev ${dev}-ifb name ${dev}-ifb type ifb
    ip link set dev ${dev}-ifb up

    tc qdisc add dev ${dev}-ifb root handle 1: htb
    tc class add dev ${dev}-ifb parent 1: classid 1:1 htb rate ${up}mbit

    tc qdisc add dev $dev ingress
    tc filter add dev $dev parent ffff: protocol ip u32 match u32 0 0 flowid 1:1 action mirred egress redirect dev ${dev}-ifb
}

iptables_stop() {
    iptables -t mangle -D FORWARD  -j eqos
    ip6tables -t mangle -D FORWARD  -j eqos
    ebtables -t nat -D POSTROUTING  -j eqos -p ipv6
    echo 0 > /sys/kernel/debug/hnat/qos_toggle
    sed -i '/\/etc\/init.d\/eqos start/d' /etc/firewall.user
    iptables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0
    iptables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0
    echo "10 0" > /sys/kernel/debug/hnat/hnat_setting
    echo "11 1" >/sys/kernel/debug/hnat/hnat_setting
    for i in $(seq 0 31); do
    echo 0 0 0 0 0 4 4 > $hqos_path/qdma_txq$i
    done
    for i in $(seq 32 63); do
    echo 1 0 0 0 0 4 4 > $hqos_path/qdma_txq$i
    done
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch0
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch1
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch2
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch3
}

iptables_start_prepare() {
    iptables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0
    iptables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0
    iptables -t mangle -A FORWARD -i br-lan -j DSCP --set-dscp 0
    iptables -t mangle -A FORWARD -o br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -A FORWARD -i br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -A FORWARD -o br-lan -j DSCP --set-dscp 0
}

iptables_start_inital() {
    iptables -t mangle -N eqos
    iptables -t mangle -F eqos
    iptables -t mangle -D FORWARD  -j eqos
    iptables -t mangle -A FORWARD  -j eqos
    echo 1 > /sys/kernel/debug/hnat/qos_toggle
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch0
    echo 0 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch1
    echo 0 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq0
    echo 1 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq8
    echo "11 1" >/sys/kernel/debug/hnat/hnat_setting
    uci -q set "turboacc.config.fastpath_mh_eth_hnat_bind_rate"="1"
    uci -q commit "turboacc"
    sed -i '/\/etc\/init.d\/eqos start/d' /etc/firewall.user
    echo "/etc/init.d/eqos start" >> /etc/firewall.user
    echo "10 1" > /sys/kernel/debug/hnat/hnat_setting
}

dscp_to_queue() {
    local dscp=$1

    if [ $dscp -eq 46 ]; then
        echo 0    # EF → Q0 (CAKE tin7)
    elif [ $dscp -eq 48 ] || [ $dscp -eq 56 ]; then
        echo 1    # CS6/CS7 → Q1 (CAKE tin6)
    elif [ $dscp -eq 32 ] || [ $dscp -eq 40 ] || [ $dscp -eq 44 ]; then
        echo 2    # CS4/CS5/VA → Q2 (CAKE tin5)
    elif [ $dscp -ge 16 ] && [ $dscp -le 23 ]; then
        echo 3    # CS2/AF2x → Q3 (CAKE tin4)
    elif ([ $dscp -ge 24 ] && [ $dscp -le 31 ]) || ([ $dscp -ge 33 ] && [ $dscp -le 39 ]); then
        echo 4    # AF3x/AF4x → Q4 (CAKE tin3)
    elif [ $dscp -eq 1 ] || ([ $dscp -ge 8 ] && [ $dscp -le 15 ]); then
        echo 31   # LE/CS1/AF1x → Q31 (CAKE tin0+1, 最低)
    else
        echo 5    # CS0(0) + 未定义 → Q5 (默认, 内核中按IP hash到Q5-Q30)
    fi
}


case "$1" in
    "stop")
#        stop_qos
    iptables_stop
    ;;
    "start")
    stop_qos
    iptables_start_prepare
#        start_qos $2 $3
    iptables_start_inital
    echo 1 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch0
    echo 1 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch1
    echo 1 sp $(($3*1000*10/10)) > /sys/kernel/debug/hnat/qdma_sch2
    echo 1 sp $(($2*1000*10/10)) > /sys/kernel/debug/hnat/qdma_sch3

    for i in $(seq 6 31); do
    echo 2 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    for i in $(seq 38 63); do
    echo 3 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq$i
    done

    echo 2 1 2000 1 $(($3*1000*10/10)) 1 4 > /sys/kernel/debug/hnat/qdma_txq11
    echo 3 1 3000 1 $(($2*1000*10/10)) 1 4 > /sys/kernel/debug/hnat/qdma_txq43

    for i in $(seq 0 5); do
    echo 0 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    for i in $(seq 32 37); do
    echo 1 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq$i
    done

    #echo 2 1 3000 0 0 256 4 > /sys/kernel/debug/hnat/qdma_txq1
    #echo 3 1 5000 0 0 256 4 > /sys/kernel/debug/hnat/qdma_txq33
    #echo 2 1 3000 0 0 256 4 > /sys/kernel/debug/hnat/qdma_txq2
    #echo 3 1 5000 0 0 256 4 > /sys/kernel/debug/hnat/qdma_txq34
    echo 2 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq0
    echo 1 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq8
    echo 3 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq32

    #iptables -t mangle -D eqos -m iprange --src-range 192.168.110.10-192.168.110.39 -j MARK --set-mark 0x99
    #iptables -t mangle -D eqos -m iprange --dst-range 192.168.110.10-192.168.110.39 -j MARK --set-mark 0x99

    #iptables -t mangle -I eqos -m iprange  --src-range 192.168.110.10-192.168.110.39 -j MARK --set-mark 0x99
    #iptables -t mangle -I eqos -m iprange  --dst-range 192.168.110.10-192.168.110.39 -j MARK --set-mark 0x99


    #iptables -t mangle -D eqos -m iprange --src-range 192.168.110.10-192.168.110.39 -j DSCP --set-dscp 46
    #iptables -t mangle -D eqos -m iprange --dst-range 192.168.110.10-192.168.110.39 -j DSCP --set-dscp 46

    #iptables -t mangle -I eqos -m iprange  --src-range 192.168.110.10-192.168.110.39 -j DSCP --set-dscp 46
    #iptables -t mangle -I eqos -m iprange  --dst-range 192.168.110.10-192.168.110.39 -j DSCP --set-dscp 46
    
    # 插入使用 u32 模块实现更精确"并且"判断的规则
    # u32 模块读取 4 字节为 32 位整数，必须使用位掩码隔离单个字节
    #
    # 源IP: 192.168.x.y, x=[110-119], y=[10-39]
    # -s 192.168.0.0/16 确保是 192.168 开头
    # 偏移 0xc = 源 IP 起始 (字节 12-15 = 192.168.x.y)
    # &0x0000FF00 掩码提取第三字节 x, =0x6E00:0x7700 即 110-119
    # &0x000000FF 掩码提取第四字节 y, =0x0A:0x27 即 10-39
    iptables -t mangle -I eqos -s 192.168.0.0/16 -m u32 --u32 "0xc&0x0000FF00=0x00006E00:0x00007700" -m u32 --u32 "0xc&0x000000FF=0x0000000A:0x00000027" -j DSCP --set-dscp 46

    # 目标IP: 192.168.x.y, x=[110-119], y=[10-39]
    # 偏移 0x10 = 目标 IP 起始 (字节 16-19)
    # 同样使用位掩码提取第三、四字节
    iptables -t mangle -I eqos -d 192.168.0.0/16 -m u32 --u32 "0x10&0x0000FF00=0x00006E00:0x00007700" -m u32 --u32 "0x10&0x000000FF=0x0000000A:0x00000027" -j DSCP --set-dscp 46

    # 192.168.109.0/24 网段: 仅加速小包 UDP（游戏包）
    # 条件: UDP 协议 + 包长度 ≤ 300 字节
    # 大于 300 的 UDP 和所有 TCP（视频/下载）不标记，走默认队列
    iptables -t mangle -I eqos -s 192.168.109.0/24 -p udp -m length --length 0:300 -j DSCP --set-dscp 46
    iptables -t mangle -I eqos -d 192.168.109.0/24 -p udp -m length --length 0:300 -j DSCP --set-dscp 46

    # Delete existing rules properly
    #iptables -t mangle -D eqos -m iprange --src-range 192.168.110.2-192.168.110.9 -j MARK --set-mark 0x99
    #iptables -t mangle -D eqos -m iprange --dst-range 192.168.110.2-192.168.110.9 -j MARK --set-mark 0x99

    #iptables -t mangle -D eqos -m iprange --src-range 192.168.110.40-192.168.110.254 -j MARK --set-mark 0x99
    #iptables -t mangle -D eqos -m iprange --dst-range 192.168.110.40-192.168.110.254 -j MARK --set-mark 0x99

    # Add new rules properly
    #iptables -t mangle -A eqos -m iprange --src-range 192.168.110.2-192.168.110.9 -j MARK --set-mark 0x99
    #iptables -t mangle -A eqos -m iprange --dst-range 192.168.110.2-192.168.110.9 -j MARK --set-mark 0x99

    #iptables -t mangle -A eqos -m iprange  --src-range 192.168.110.40-192.168.110.254 -j MARK --set-mark 0x99
    #iptables -t mangle -A eqos -m iprange  --dst-range 192.168.110.40-192.168.110.254 -j MARK --set-mark 0x99

    ;;
    "add")
    ip="$2"
    dl="$3"
    up="$4"
    id="$5" idpair=$((id+32))
    macaddr="$6"
    cnt=$(tc class show dev $dev | wc -l)



    dscp=$id

    up_id=$(dscp_to_queue $id)
    down_id=$((up_id+32))


    if [ $id -eq 64 ]; then

        iptables -t mangle -D eqos -s $ip -j DSCP --set-dscp 46
        iptables -t mangle -D eqos -d $ip -j DSCP --set-dscp 46
        ip6tables -t mangle -D eqos -m mac --mac-source $macaddr -j MARK --set-mark 46
        ebtables -t nat -D eqos -p ipv6 -d $macaddr -j mark --mark-set 46

        iptables -t mangle -A eqos -s $ip -j DSCP --set-dscp 46
        ip6tables -t mangle -A eqos -m mac --mac-source $macaddr -j MARK --set-mark 46

        iptables -t mangle -A eqos -d $ip -j DSCP --set-dscp 46
        ebtables -t nat -A eqos -p ipv6 -d $macaddr -j mark --mark-set 46

    elif [ $id -lt 64 ]; then
        iptables -t mangle -D eqos -s $ip -j DSCP --set-dscp ${dscp}
        iptables -t mangle -D eqos -d $ip -j DSCP --set-dscp ${dscp}
        ip6tables -t mangle -D eqos -m mac --mac-source $macaddr -j MARK --set-mark ${dscp}
        ebtables -t nat -D eqos -p ipv6 -d $macaddr -j mark --mark-set ${dscp}


        iptables -t mangle -A eqos -s $ip -j DSCP --set-dscp ${dscp}
        ip6tables -t mangle -A eqos -m mac --mac-source $macaddr -j MARK --set-mark ${dscp}

        if [ $up_id -ne 0 ]; then

        if [ $up -ne 0 ]; then
            echo 2 1 ${up} 0 0 4 1 > /sys/kernel/debug/hnat/qdma_txq${up_id}
        else
            echo 2 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq${up_id}
        fi

        if [ $dl -ne 0 ]; then
            echo 3 1 ${dl} 0 0 4 1 > /sys/kernel/debug/hnat/qdma_txq${down_id}
        else
            echo 3 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq${down_id}
        fi

        fi


        iptables -t mangle -A eqos -d $ip -j DSCP --set-dscp ${dscp}
        ebtables -t nat -A eqos -p ipv6 -d $macaddr -j mark --mark-set ${dscp}
    else
        iptables -t mangle -D eqos -s $ip -j MARK --set-mark 0x99
        iptables -t mangle -D eqos -d $ip -j MARK --set-mark 0x99
        if [ $up -ne 0 ]; then
        iptables -t mangle -A eqos -s $ip -j MARK --set-mark 0x99
        fi
        if [ $dl -ne 0 ]; then
        iptables -t mangle -A eqos -d $ip -j MARK --set-mark 0x99
        fi
    fi

    if [ $id -gt 64 ]; then
        tc class add dev $dev parent 1:1 classid 1:1$cnt htb rate ${dl}kbit ceil ${dl}kbit
        tc filter add dev $dev parent 1:0 protocol ip u32 match ip dst $ip flowid 1:1$cnt

        tc class add dev ${dev}-ifb parent 1:1 classid 1:1$cnt htb rate ${up}kbit ceil ${up}kbit
        tc filter add dev ${dev}-ifb parent 1:0 protocol ip u32 match ip src $ip flowid 1:1$cnt
    fi
    ;;
    *)
    echo "Usage: $0 <command> [options]"
    echo "Commands:"
    echo "  start dl_rate up_rate       #Total bandwidth (Mbit/s)"
    echo "  stop"
    echo "  add ip dl_rate up_rate      #Limiting the bandwidth of a single IP (kbit/s)"
    echo "Example:"
    echo "  $0 start 30 20              # Total bandwidth: down 30Mbit/s up 20Mbit/s"
    echo "  $0 add 192.168.22.12 10 2   # down 10kbit/s  up 2kbit/s"
    ;;
esac

