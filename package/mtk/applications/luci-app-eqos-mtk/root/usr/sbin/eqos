#!/bin/sh
# eqos - Hardware QoS management script
#
# ═══════════════════════════════════════════════════════════════
#  IPv4 队列分配规则（已通过代码逐行审计验证）
# ═══════════════════════════════════════════════════════════════
#
# SP 专属队列（Strict Priority，最高优先级，零共享）：
#   Q0  (DSCP=0 ) : VIP 上传 SP EF  — 仅 VIP 设备占用
#   Q32 (DSCP=32) : VIP 下载 SP EF  — 仅 VIP 设备占用
#   Q1  (DSCP=1 ) : 游戏上传 SP EF  — 109.x 子网 UDP≤300B
#   Q33 (DSCP=33) : 游戏下载 SP EF  — 109.x 子网 UDP≤300B
#
# VIP 设备判定（满足任一条件即为 VIP → Q0/Q32）：
#   ① 静态 u32 规则（FORWARD 链静态规则；显式限速设备有最终覆盖规则）：
#        条件：-s/-d 192.168.0.0/16（只适用于 192.168.x.x 地址段）
#             AND 第三段 0x6E-0x77 = 110-119
#             AND 第四段 0x0A-0x27 = 10-39
#        即：192.168.{110-119}.{10-39} → Q0(上传) / Q32(下载)
#        第四段 .1-.9   = 不在 VIP 范围（走 WRR 普通槽）
#        第四段 .40-.254 = 不在 VIP 范围（DHCP 下发范围，走 WRR）
#   ② eqos add comment=64 或 comment=vip（eqos chain 头部插入）：
#        适用于任意 IP 的设备，在 LuCI 中显式标记为 VIP
#        → DSCP=0 (upload), DSCP=32 (download) → Q0/Q32
#
# WRR 普通槽（per-user 隔离，AF41）：
#   Q2-Q30  (DSCP=2-30 ) : 上传 WRR sch2 — 29 个用户 hash 槽
#   Q34-Q62 (DSCP=34-62) : 下载 WRR sch3 — 29 个用户 hash 槽
#   兜底默认（所有未匹配设备）：
#     iptables_start_prepare() 把所有 LAN 上传默认设为 DSCP=2 (Q2)
#     iptables_start_prepare() 把所有 LAN 下载默认设为 DSCP=34 (Q34)
#     → 任何未在 eqos/dhcp_mark 中配置的设备自动进入 WRR
#   精确分槽路径（覆盖默认值）：
#     路径 A — eqos add（rates=0 且 comment≠vip）：
#       Branch 3：MD5 hash → slot 2-30，upload DSCP=slot，download DSCP=slot+32
#     路径 B — dhcp_mark.sh（DHCP 设备，需 smarthqos=1）：
#       MAC 哈希 → MARK 2-30，iptables DSCP=MARK(upload) / MARK+32(download)
#
# 109.x 子网的完整流量路径：
#   UDP ≤300B → FORWARD 链静态规则 → DSCP=1/33 → Q1/Q33 (SP EF)
#     （若该 IP 被显式配置为限速设备，最终覆盖规则会改回 Q31/Q63）
#   其余（TCP / UDP>300B）→ 兜底默认 DSCP=2/34 → Q2/Q34 WRR
#     （若该设备已配置 eqos add 或 dhcp_mark.sh 处理，则用精确 hash 槽）
#
# 手动指定任意 IP 段的设备：
#   无论第四段是 .1-.9 / .40-.254 还是其他范围，
#   未配置则走兜底 DSCP=2/34（WRR），配置了则走对应规则
#
# 限速队列（所有限速设备共享，BE）：
#   Q31 (DSCP=31) : 限速上传 WRR BE sch2
#   Q63 (DSCP=63) : 限速下载 WRR BE sch3
#   触发条件：eqos add 时 dl>0 OR up>0（任一非零均走限速队列）
#   注意：限速设备同时使用 eqos 链头规则和 FORWARD 链最终覆盖规则，
#   即使命中 109 小包或静态 VIP 规则，最后仍进入 Q31/Q63。
#   限速完全由硬件实现：Q31/Q63 使用 WRR BE 调度器（最低优先级），
#   拥塞时 VIP/WRR 流量优先发送，限速设备只获得剩余带宽。
#   无软件 tc HTB，无 IFB 设备，零 CPU 开销。
#
# ═══════════════════════════════════════════════════════════════
#  IPv6 队列分配规则（2 类，按 MAC 识别，无 u32 IP 匹配）
# ═══════════════════════════════════════════════════════════════
#
# 类型 1 — 普通 WRR（无限速配置的设备）：
#   上传：ip6tables -m mac --mac-source MAC -j MARK --set-mark {2-30}
#   下载：ebtables  -p ipv6 -d MAC -j mark --mark-set {34-62}
#   值：mark+32，即 MARK=2 → ebtables=34，MARK=30 → ebtables=62
#   来源：dhcp_mark.sh（DHCP 设备）或 eqos add Branch 3（有 MAC 参数时）
#   与 IPv4 对应设备共享同一 WRR hash slot
#
# 类型 2 — 限速队列（LuCI 配置了带宽限速的设备）：
#   上传：ip6tables -m mac --mac-source MAC -j MARK --set-mark 31
#   下载：ebtables  -p ipv6 -d MAC -j mark --mark-set 63
#   来源：eqos add Branch 2（dl>0 或 up>0 时，有 MAC 参数）
#   进入 Q31/Q63 限速队列（与 IPv4 限速设备共用）
#
# 注：IPv6 无 SP VIP 队列（DSCP=0/32 机制不适用于 IPv6）
#     VIP 优先级仅由 IPv4 地址的 u32 规则和 eqos chain 规则承担

dev=br-lan
rl_max_file="/tmp/rl_max_rates"  # 格式: "<max_dl_kbps> <max_up_kbps>"
rl_forward_file="/tmp/rl_forward_ips"

# Returns hash slot 2-30 (29 per-user slots)
generate_index() {
    local input="$1"
    local hash_value=$(echo -n "$input" | md5sum | cut -d' ' -f1)
    local decimal_value=$((0x${hash_value:0:8}))
    local index=$((decimal_value % 29 + 2))
    echo $index
}

log_debug() {
    logger -p daemon.debug -t eqos "$*" 2>/dev/null || true
}

stop_qos() {
    tc qdisc del dev $dev root 2>/dev/null
    tc qdisc del dev $dev ingress 2>/dev/null
    tc qdisc del dev ${dev}-ifb root 2>/dev/null
    ip link del dev ${dev}-ifb 2>/dev/null
    rm -f "$rl_max_file"
}

# 更新 Q31/Q63 的硬件 max_rate shaper。
# 取本次调用的 dl/up 与历史最大值比较，写入较大值到 qdma_txq31/txq63。
# 参数：$1=dl_kbps（下载速率，0表示不限）  $2=up_kbps（上传速率，0表示不限）
# Q31 格式：sch=2(sch2) min_en=0 min_rate=0 max_en=1 max_rate=<kbps> weight=4 resv=4
# Q63 格式：sch=3(sch3) min_en=0 min_rate=0 max_en=1 max_rate=<kbps> weight=4 resv=4
update_rl_hw_rate() {
    local cur_dl=${1:-0}
    local cur_up=${2:-0}
    local max_dl max_up
    read max_dl max_up < "$rl_max_file" 2>/dev/null || { max_dl=0; max_up=0; }

    [ "$cur_dl" -gt "$max_dl" ] && max_dl=$cur_dl
    [ "$cur_up" -gt "$max_up" ] && max_up=$cur_up
    echo "$max_dl $max_up" > "$rl_max_file"

    # Q31: 上传限速队列（sch2），配置硬件 max_rate shaper
    if [ "$max_up" -gt 0 ]; then
        echo 2 0 0 1 $max_up 4 4 > /sys/kernel/debug/hnat/qdma_txq31
    else
        echo 2 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq31
    fi

    # Q63: 下载限速队列（sch3），配置硬件 max_rate shaper
    if [ "$max_dl" -gt 0 ]; then
        echo 3 0 0 1 $max_dl 4 4 > /sys/kernel/debug/hnat/qdma_txq63
    else
        echo 3 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq63
    fi
}

# start_qos() 已移除：不使用软件限速（tc HTB/IFB）。
# 限速完全由硬件 Q31/Q63 WRR BE 队列承担。

# Helper: remove game+VIP rules from FORWARD chain (called by stop and before re-init)
remove_static_forward_rules() {
    # 109.x game rules
    iptables -t mangle -D FORWARD \
        -p udp -m length --length :300 \
        -s 192.168.109.0/24 -j DSCP --set-dscp 1  2>/dev/null
    iptables -t mangle -D FORWARD \
        -p udp -m length --length :300 \
        -d 192.168.109.0/24 -j DSCP --set-dscp 33 2>/dev/null
    # Static VIP u32 rules
    iptables -t mangle -D FORWARD -s 192.168.0.0/16 \
        -m u32 --u32 "0xc&0x0000FF00=0x00006E00:0x00007700" \
        -m u32 --u32 "0xc&0x000000FF=0x0000000A:0x00000027" \
        -j DSCP --set-dscp 0  2>/dev/null
    iptables -t mangle -D FORWARD -d 192.168.0.0/16 \
        -m u32 --u32 "0x10&0x0000FF00=0x00006E00:0x00007700" \
        -m u32 --u32 "0x10&0x000000FF=0x0000000A:0x00000027" \
        -j DSCP --set-dscp 32 2>/dev/null
}

delete_ipv4_forward_device_rules() {
    local ip="$1"
    local d
    [ -n "$ip" ] || return 0

    for d in $(seq 0 63); do
        while iptables -t mangle -D FORWARD -s "$ip" \
            -j DSCP --set-dscp $d 2>/dev/null; do :; done
        while iptables -t mangle -D FORWARD -d "$ip" \
            -j DSCP --set-dscp $d 2>/dev/null; do :; done
    done
}

cleanup_ipv4_forward_device_rules() {
    local ip="$1"
    [ -n "$ip" ] || return 0

    log_debug "[EQOS-B013-01] cleanup IPv4 FORWARD device override: ip=$ip"
    delete_ipv4_forward_device_rules "$ip"
    if [ -f "$rl_forward_file" ]; then
        grep -vxF "$ip" "$rl_forward_file" > "${rl_forward_file}.tmp" 2>/dev/null || true
        mv "${rl_forward_file}.tmp" "$rl_forward_file"
    fi
}

cleanup_recorded_ipv4_forward_rules() {
    local ip

    [ -f "$rl_forward_file" ] || return 0
    log_debug "[EQOS-B013-02] cleanup recorded IPv4 FORWARD overrides: file=$rl_forward_file"
    while read -r ip; do
        delete_ipv4_forward_device_rules "$ip"
    done < "$rl_forward_file"
    : > "$rl_forward_file"
}

record_rate_limit_forward_ip() {
    local ip="$1"
    [ -n "$ip" ] || return 0

    touch "$rl_forward_file"
    grep -qxF "$ip" "$rl_forward_file" 2>/dev/null || echo "$ip" >> "$rl_forward_file"
    log_debug "[EQOS-B013-03] record rate-limit FORWARD override: ip=$ip"
}

cleanup_ipv6_mac_rules() {
    local mac="$1"
    local d
    [ -n "$mac" ] || return 0

    for d in $(seq 2 31); do
        while ip6tables -t mangle -D eqos -m mac --mac-source "$mac" \
            -j MARK --set-mark $d 2>/dev/null; do :; done
    done
    for d in $(seq 34 63); do
        while ebtables -t nat -D eqos -p ipv6 -d "$mac" \
            -j mark --mark-set $d 2>/dev/null; do :; done
    done
}

iptables_stop() {
    iptables  -t mangle -D FORWARD -j eqos 2>/dev/null
    ip6tables -t mangle -D FORWARD -j eqos 2>/dev/null
    ebtables  -t nat   -D POSTROUTING -j eqos -p ipv6 2>/dev/null
    echo 0 > /sys/kernel/debug/hnat/qos_toggle
    sed -i '/\/etc\/init.d\/eqos start/d' /etc/firewall.user
    remove_static_forward_rules
    iptables  -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 2  2>/dev/null
    iptables  -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 34 2>/dev/null
    ip6tables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0 2>/dev/null
    ip6tables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0 2>/dev/null
    echo "10 0" > /sys/kernel/debug/hnat/hnat_setting
    echo "11 30" > /sys/kernel/debug/hnat/hnat_setting
    cleanup_recorded_ipv4_forward_rules
    for i in $(seq 0 31); do
        echo 0 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    for i in $(seq 32 63); do
        echo 1 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    echo 0 wrr 10000000 > /sys/kernel/debug/hnat/qdma_sch0
    echo 0 wrr 10000000 > /sys/kernel/debug/hnat/qdma_sch1
    echo 0 wrr 10000000 > /sys/kernel/debug/hnat/qdma_sch2
    echo 0 wrr 10000000 > /sys/kernel/debug/hnat/qdma_sch3
}

iptables_start_prepare() {
    # Default all LAN traffic to WRR fallback slots:
    #   Upload (from LAN, -i br-lan) → DSCP=2  → Q2  (WRR sch2, lowest per-user slot)
    #   Download (to LAN, -o br-lan) → DSCP=34 → Q34 (WRR sch3, lowest per-user slot)
    # This ensures ANY unconfigured device (static IP / unknown / 109.x non-game)
    # lands in WRR instead of accidentally hitting Q0 (VIP SP).
    # Per-device rules in the eqos chain override this default for known devices.
    iptables  -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 2  2>/dev/null
    iptables  -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 34 2>/dev/null
    iptables  -t mangle -A FORWARD -i br-lan -j DSCP --set-dscp 2
    iptables  -t mangle -A FORWARD -o br-lan -j DSCP --set-dscp 34
    ip6tables -t mangle -D FORWARD -i br-lan -j DSCP --set-dscp 0 2>/dev/null
    ip6tables -t mangle -D FORWARD -o br-lan -j DSCP --set-dscp 0 2>/dev/null
    ip6tables -t mangle -A FORWARD -i br-lan -j DSCP --set-dscp 0
    ip6tables -t mangle -A FORWARD -o br-lan -j DSCP --set-dscp 0
}

iptables_start_inital() {
    iptables -t mangle -N eqos 2>/dev/null
    iptables -t mangle -F eqos
    iptables -t mangle -D FORWARD -j eqos 2>/dev/null
    iptables -t mangle -A FORWARD -j eqos
    echo 1 > /sys/kernel/debug/hnat/qos_toggle

    # sch0: Strict Priority for upload  (Q0=VIP, Q1=game → absolute priority)
    # enable=1, sp mode (BIT(15)=0), rate=10G (effectively unlimited)
    echo 1 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch0
    # sch1: Strict Priority for download (Q32=VIP, Q33=game → absolute priority)
    echo 1 sp 10000000 > /sys/kernel/debug/hnat/qdma_sch1

    # Q0:  VIP upload  SP → sch0, no rate limit
    echo 0 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq0
    # Q1:  Game upload SP → sch0, no rate limit
    echo 0 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq1
    # Q2-Q30: WRR per-user upload → sch2 (AF41, normal priority)
    # MUST be explicit: iptables_stop resets Q0-31 to sch=0 (SP).
    # Without this loop, normal devices would run at SP priority = same as VIP.
    for i in $(seq 2 30); do
        echo 2 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    # Q31: Rate-limited upload WRR → sch2 (lower priority than VIP/game)
    echo 2 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq31
    # Q32: VIP download  SP → sch1, no rate limit
    echo 1 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq32
    # Q33: Game download SP → sch1, no rate limit
    echo 1 0 0 0 0 0 0 > /sys/kernel/debug/hnat/qdma_txq33
    # Q34-Q62: WRR per-user download → sch3 (AF41, normal priority)
    # MUST be explicit: iptables_stop resets Q32-63 to sch=1 (SP).
    for i in $(seq 34 62); do
        echo 3 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq$i
    done
    # Q63: Rate-limited download WRR → sch3 (lower priority than VIP/game)
    echo 3 0 0 0 0 4 4 > /sys/kernel/debug/hnat/qdma_txq63

    # ── Static rules in FORWARD chain (survives dhcp_mark.sh eqos flush) ──
    # FORWARD chain order: global-clear → -j eqos → game → VIP → rate-limit override
    # Last matching DSCP rule wins. The final per-IP rate-limit override is
    # installed by 'eqos add' for limited devices so Q31/Q63 remain authoritative.
    cleanup_recorded_ipv4_forward_rules
    remove_static_forward_rules  # idempotent: remove before re-adding

    # 109.x game acceleration: UDP<=300B → Q1(DSCP=1) upload / Q33(DSCP=33) download
    iptables -t mangle -A FORWARD \
        -p udp -m length --length :300 \
        -s 192.168.109.0/24 -j DSCP --set-dscp 1
    iptables -t mangle -A FORWARD \
        -p udp -m length --length :300 \
        -d 192.168.109.0/24 -j DSCP --set-dscp 33

    # Static VIP range: 192.168.110-119.10-39 → Q0 upload / Q32 download
    # u32 bitfield: 0xc=src IP, 0x10=dst IP
    # 3rd octet 0x6E-0x77=110-119, 4th octet 0x0A-0x27=10-39
    # Appended after eqos/game rules; explicit rate-limit devices get a later
    # per-IP override so every limited device still lands in Q31/Q63.
    iptables -t mangle -A FORWARD -s 192.168.0.0/16 \
        -m u32 --u32 "0xc&0x0000FF00=0x00006E00:0x00007700" \
        -m u32 --u32 "0xc&0x000000FF=0x0000000A:0x00000027" \
        -j DSCP --set-dscp 0
    iptables -t mangle -A FORWARD -d 192.168.0.0/16 \
        -m u32 --u32 "0x10&0x0000FF00=0x00006E00:0x00007700" \
        -m u32 --u32 "0x10&0x000000FF=0x0000000A:0x00000027" \
        -j DSCP --set-dscp 32

    echo "11 5" > /sys/kernel/debug/hnat/hnat_setting
    uci -q set "turboacc.config.fastpath_mh_eth_hnat_bind_rate"="5"
    uci -q commit "turboacc"
    sed -i '/\/etc\/init.d\/eqos start/d' /etc/firewall.user
    echo "/etc/init.d/eqos start" >> /etc/firewall.user
    echo "10 1" > /sys/kernel/debug/hnat/hnat_setting
}

case "$1" in
    "stop")
        stop_qos
        iptables_stop
        ;;

    "start")
        stop_qos                   # stop_qos 内已清理 rl_max_file
        iptables_start_prepare
        iptables_start_inital
        # sch2: WRR for upload  (Q2-Q30 per-user, Q31 rate-limited WRR BE)
        echo 1 wrr $(($3*1000)) > /sys/kernel/debug/hnat/qdma_sch2
        # sch3: WRR for download (Q34-Q62 per-user, Q63 rate-limited WRR BE)
        echo 1 wrr $(($2*1000)) > /sys/kernel/debug/hnat/qdma_sch3
        ;;

    "add")
        ip="$2"
        dl="$3"
        up="$4"
        comment="$5"   # "64" or "vip" = VIP device
        macaddr="$6"
        interface="$7"

        # Pre-compute deterministic WRR slot for this IP.
        # generate_index is pure-hash (no file state), so the same device key
        # maps to the same ordinary slot. MAC-only IPv6 hosts use MAC as key.
        hash_key="${ip:-$macaddr}"
        if [ -z "$hash_key" ]; then
            echo "eqos add: skip device without ip/mac" >&2
            exit 1
        fi
        wrr_id=$(generate_index "$hash_key")
        wrr_dl=$((wrr_id + 32))

        # ── Unified cleanup: remove ALL possible previous DSCP rules for $ip ──
        # Covers: VIP(0/32), WRR(2-30/34-62), rate-limit(31/63),
        # and dhcp_mark.sh smarthqos range (1-31 upload, 33-63 download).
        # Exhaustive loop guarantees no stale rule survives a state transition.
        if [ -n "$ip" ]; then
            for d in $(seq 0 31); do
                while iptables -t mangle -D eqos -s "$ip" -j DSCP --set-dscp $d 2>/dev/null; do :; done
            done
            for d in $(seq 32 63); do
                while iptables -t mangle -D eqos -d "$ip" -j DSCP --set-dscp $d 2>/dev/null; do :; done
            done
            cleanup_ipv4_forward_device_rules "$ip"
        fi
        cleanup_ipv6_mac_rules "$macaddr"

        if [ "$comment" = "64" ] || [ "$comment" = "vip" ]; then
            # ── Branch 1: VIP → Q0 upload (SP EF) / Q32 download (SP EF) ──
            # Upload DSCP=0 at chain head overrides any smarthqos WRR rule.
            # Static u32 at chain-end also sets 0 for the static range (11x.10-39);
            # this explicit rule covers dynamically-promoted DHCP devices (40-254).
            if [ -n "$ip" ]; then
                iptables -t mangle -I eqos 1 -s "$ip" -j DSCP --set-dscp 0
                iptables -t mangle -I eqos 1 -d "$ip" -j DSCP --set-dscp 32
            fi

        elif [ "${up:-0}" -ne 0 ] || [ "${dl:-0}" -ne 0 ]; then
            # ── Branch 2: Rate-limited → Q31 upload / Q63 download (WRR BE) ──
            # 硬件限速策略：
            #   1. DSCP 标记双向打 31/63 → HNAT qid=31/63 → Q31/Q63 WRR BE
            #   2. 取所有限速设备中 dl 的最大值配置 Q63 的硬件 max_rate shaper，
            #      取所有限速设备中 up 的最大值配置 Q31 的硬件 max_rate shaper。
            #      效果：所有限速设备共享 Q31/Q63，总带宽上限 = 配置中的最大值，
            #      同时 WRR BE 确保拥塞时让位给 VIP 和普通 WRR 流量。
            if [ -n "$ip" ]; then
                iptables -t mangle -I eqos 1 -s "$ip" -j DSCP --set-dscp 31
                iptables -t mangle -I eqos 1 -d "$ip" -j DSCP --set-dscp 63
                iptables -t mangle -A FORWARD -s "$ip" -j DSCP --set-dscp 31
                iptables -t mangle -A FORWARD -d "$ip" -j DSCP --set-dscp 63
                record_rate_limit_forward_ip "$ip"
                log_debug "[EQOS-B013-04] install rate-limit final override: ip=$ip dl=${dl:-0} up=${up:-0} upload_qid=31 download_qid=63"
            fi

            # 更新 Q31/Q63 硬件 max_rate（取历史最大值）
            update_rl_hw_rate "${dl:-0}" "${up:-0}"

            # IPv6 MAC-based marking → Q31 upload / Q63 download
            if [ -n "$macaddr" ]; then
                ip6tables -t mangle -I eqos 1 -m mac --mac-source "$macaddr" \
                    -j MARK --set-mark 31
                ebtables -t nat -A eqos -p ipv6 -d "$macaddr" \
                    -j mark --mark-set 63
            fi

        else
            # ── Branch 3: WRR per-user slot → Q${wrr_id} / Q${wrr_dl} (WRR AF41) ──
            # rates=0 and no VIP comment: per-user WRR isolation without rate limit.
            # Covers: LuCI device added without explicit limits, or smarthqos
            # auto-assign path if dhcp_mark.sh calls eqos add with rates=0.
            # Deterministic hash: same IP always maps to same slot (2-30 range).
            # Static VIP u32 at chain-end still overrides for 11x.10-39 range.
            if [ -n "$ip" ]; then
                iptables -t mangle -I eqos 1 -s "$ip" -j DSCP --set-dscp "$wrr_id"
                iptables -t mangle -I eqos 1 -d "$ip" -j DSCP --set-dscp "$wrr_dl"
            fi

            # IPv6 MAC-based marking
            if [ -n "$macaddr" ]; then
                ip6tables -t mangle -I eqos 1 -m mac --mac-source "$macaddr" \
                    -j MARK --set-mark "$wrr_id"
                ebtables -t nat -A eqos -p ipv6 -d "$macaddr" \
                    -j mark --mark-set "$wrr_dl"
            fi
        fi  # end of 3-way branch

        # Multi-WAN load balance interface binding
        if [ "$interface" ]; then
            iptables -t mangle -D PREROUTING -s "$ip" \
                -m conntrack --ctstate NEW -j MARK --set-mark 2"$interface" 2>/dev/null
            iptables -t mangle -A PREROUTING -s "$ip" \
                -m conntrack --ctstate NEW -j MARK --set-mark 2"$interface"
            iptables -t mangle -D PREROUTING -i br-lan \
                -m conntrack --ctstate ESTABLISHED,RELATED \
                -j CONNMARK --restore-mark 2>/dev/null
            iptables -t mangle -A PREROUTING -i br-lan \
                -m conntrack --ctstate ESTABLISHED,RELATED \
                -j CONNMARK --restore-mark
        fi
        ;;

    *)
        echo "Usage: $0 <command> [options]"
        echo "Commands:"
        echo "  start dl_rate up_rate"
        echo "  stop"
        echo "  add ip dl_kbps up_kbps [64|vip] [mac] [iface]"
        echo ""
        echo "Queue layout:"
        echo "  Q0/Q32  : VIP SP        (static 192.168.11x.10-39 OR comment=64/vip)"
        echo "  Q1/Q33  : Game SP       (109.x UDP<=300B, automatic FORWARD rule)"
        echo "  Q2-Q30/Q34-Q62: WRR AF41 per-user (eqos add rates=0, or dhcp_mark.sh)"
        echo "  Q31/Q63 : Rate-limit WRR BE (all rate-limited devices share)"
        echo "            hw max_rate = max(all up) for Q31, max(all dl) for Q63"
        ;;
esac
