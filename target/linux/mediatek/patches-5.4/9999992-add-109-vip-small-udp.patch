+// 判断IP地址是否在 192.168.109.[2-254] 范围内
+static bool is_ip_in_109_range_k(__be32 ip_be)
+{
+	const u8 *p = (const u8 *)&ip_be;
+
+	if (p[0] != 192 || p[1] != 168)
+		return false;
+	if (p[2] != 109)
+		return false;
+	if (p[3] < 2 || p[3] > 254)
+		return false;
+	return true;
+}

