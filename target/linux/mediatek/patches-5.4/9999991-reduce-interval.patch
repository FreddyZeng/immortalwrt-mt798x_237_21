+// 判断IP地址是否在指定范围内
+static bool is_ip_in_range_k(__be32 ip)
+{
+    // 提取前两个字节（固定为 192.168）
+    __be32 prefix_192_168 = htonl((192 << 24) | (168 << 16));
+
+    // 提取 IP 的第三个字节
+    __be32 third_byte = (ip >> 8) & htonl(0xFF);
+
+    // 提取 IP 的最后一个字节
+    __be32 last_byte = ip & htonl(0xFF);
+
+    // 判断前两个字节是否匹配 (192.168)
+    // 判断第三个字节是否在 110 到 119 之间
+    // 判断最后一个字节是否在 10 到 39 之间
+    return (ip & htonl(0xFFFF0000)) == prefix_192_168 &&
+           third_byte >= 110 && third_byte <= 119 &&
+           last_byte >= 10 && last_byte <= 39;
+}
+
